# Copie para .dev.vars ao testar localmente com: npm run pages:dev
# No painel Cloudflare: Settings → Variables (Production)

FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
WEBHOOK_TOKEN=seu-token-secreto
FIRESTORE_COLLECTION=suportes_tecnicos

# NAO cadastre CLOUDFLARE_API_TOKEN nas variaveis do painel Cloudflare.
# Isso sobrescreve o token de build e causa "Authentication error [10000]" no deploy.
