# Copie para .dev.vars ao testar localmente com: npm run pages:dev
# No painel Cloudflare: Settings → Variables (Production)

FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
WEBHOOK_TOKEN=seu-token-secreto
FIRESTORE_COLLECTION=suportes_tecnicos

# NAO cadastre CLOUDFLARE_API_TOKEN nem CLOUDFLARE_API_KEY nas variaveis do painel Cloudflare.
# Token manual sem permissao "Cloudflare Pages - Edit" causa Authentication error [10000].
# O build do Git ja fornece credencial automatica; remova essas chaves em Variables and secrets.
