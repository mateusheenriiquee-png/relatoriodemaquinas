# Supabase (Worker) — configurar como SECRETS: `wrangler secret put SUPABASE_SERVICE_ROLE_KEY`.
# A service_role ignora a RLS: nunca vai para o painel (VITE_*) nem para o git.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Security Tokens
WEBHOOK_TOKEN=your-webhook-token-here
SHEETS_SYNC_TOKEN=your-sheets-sync-token-here

# Optional: Apps Script Integration (if using sheets)
APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=

# Kommo CRM integration (POST /webhook/kommo)
# KOMMO_ACCESS_TOKEN: token de integracao privada de longa duracao do Kommo.
# KOMMO_BASE_URL: ex. https://SEUDOMINIO.kommo.com
# Em producao, configure via `wrangler secret put KOMMO_ACCESS_TOKEN` (nunca em wrangler.toml).
KOMMO_ACCESS_TOKEN=
KOMMO_BASE_URL=

# Deployment
NODE_ENV=development
PORT=3000
