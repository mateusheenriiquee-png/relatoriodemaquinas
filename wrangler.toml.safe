name = "suportetecnico-api"
main = "worker/index.mjs"
compatibility_date = "2024-11-12"
compatibility_flags = ["nodejs_compat"]
keep_vars = true

[env.production.vars]
ENVIRONMENT = "production"
FIREBASE_PROJECT_ID = "suportetecnico-api2"
USUARIOS_COLLECTION = "usuarios"

[env.production.secrets]
# Configure FIREBASE_SERVICE_ACCOUNT como Secret no Cloudflare Dashboard

[assets]
directory = "./public"
binding = "ASSETS"
