rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir acesso à coleção de usuários
    match /usuarios/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (isAdmin(request.auth.uid) || isAdminRequest());
      allow update: if request.auth != null && (isAdmin(request.auth.uid) || request.auth.uid == userId);
      allow delete: if request.auth != null && isAdmin(request.auth.uid);
    }

    // Permitir acesso à coleção de suportes técnicos
    match /suportes_tecnicos/{document=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && isAdmin(request.auth.uid);
    }

    // Permitir acesso à configuração de admin
    match /config/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin(request.auth.uid);
    }

    // Função para verificar se é uma requisição do servidor (vem do Cloudflare Worker)
    function isAdminRequest() {
      return request.auth.uid == 'admin-server' || 
             (request.auth != null && request.auth.token.iss == 'https://securetoken.google.com/suportetecnico-api');
    }

    // Função auxiliar para verificar se o usuário é admin
    function isAdmin(userId) {
      let userDoc = get(/databases/$(database)/documents/usuarios/$(userId));
      return userDoc.exists && userDoc.data.cargo == 'admin';
    }
  }
}
