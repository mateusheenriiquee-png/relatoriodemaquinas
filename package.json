{
  "name": "suportetecnico-api",
  "version": "1.0.0",
  "description": "Painel web + Worker (Cloudflare) + Supabase para registro de suportes técnicos",
  "scripts": {
    "cf:deploy": "node scripts/cf-pages-deploy.js",
    "web:install": "npm install --prefix src/frontend/web",
    "web:dev": "npm run dev --prefix src/frontend/web",
    "web:build": "npm run build --prefix src/frontend/web",
    "web:preview": "npm run preview --prefix src/frontend/web",
    "web:test": "npm run test --prefix src/frontend/web",
    "test:backend": "node --test \"src/backend/__tests__/*.test.mjs\"",
    "cadastro:install": "npm install --prefix src/frontend/cadastro",
    "cadastro:dev": "npm run dev --prefix src/frontend/cadastro",
    "cadastro:build": "npm run build --prefix src/frontend/cadastro",
    "cadastro:test": "npm run test --prefix src/frontend/cadastro",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm run test:backend && npm run web:test && npm run cadastro:test"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "pg": "^8.23.0",
    "prettier": "^3.0.0",
    "wrangler": "^4.124.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mateusheenriiquee-png/relatoriodemaquinas.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/mateusheenriiquee-png/relatoriodemaquinas/issues"
  },
  "homepage": "https://github.com/mateusheenriiquee-png/relatoriodemaquinas#readme"
}
