rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir acesso à coleção de usuários
    match /usuarios/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isAdmin(request.auth.uid);
      allow update: if request.auth != null && (isAdmin(request.auth.uid) || request.auth.uid == userId);
      allow delete: if request.auth != null && isAdmin(request.auth.uid);
    }

    // Permitir acesso à coleção de suportes técnicos
    match /suportes_tecnicos/{document=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;  // Qualquer usuário autenticado pode deletar (backend valida admin)
    }

    // Permitir acesso à configuração de admin
    match /config/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin(request.auth.uid);
    }

    // Função auxiliar para verificar se o usuário é admin
    // Nota: Admin SDK bypassa essas regras automaticamente
    function isAdmin(userId) {
      let userDoc = get(/databases/$(database)/documents/usuarios/$(userId));
      return userDoc.exists && (
        userDoc.data.cargo == 'admin' || 
        userDoc.data.cargo == 'Administrador' ||
        userDoc.data.cargo == 'administrador'
      );
    }
  }
}
